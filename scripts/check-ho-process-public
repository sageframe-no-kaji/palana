#!/usr/bin/env ruby

require "pathname"
require "find"

arguments = ARGV.dup
root = Pathname(arguments.shift || File.expand_path("../ho-process", __dir__))
blocklist = nil

until arguments.empty?
  option = arguments.shift
  case option
  when "--blocklist"
    blocklist = Pathname(arguments.shift || abort("missing path after --blocklist"))
  else
    abort("unknown option: #{option}")
  end
end

abort("not a directory: #{root}") unless root.directory?

patterns = {
  "email address" => /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,
  "macOS home path" => %r{/Users/(?!example(?:/|$)|\.\.\.(?:/|$))[A-Za-z0-9._-]+(?=/|$)},
  "Linux home path" => %r{/home/(?!example(?:/|$)|\.\.\.(?:/|$))[A-Za-z0-9._-]+(?=/|$)},
  "private workspace path" => %r{~/(?:Desktop|Documents|Downloads|Vaults)/},
  "private IPv4 address" => /(?<!\d)(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?!\d)/,
  "private key" => /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/,
  "AWS access key" => /(?<![A-Z0-9])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Z0-9])/,
  "GitHub token" => /(?:github_pat_|gh[pousr]_)[A-Za-z0-9_]{20,}/,
  "OpenAI key" => /(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}/,
  "Google API key" => /AIza[A-Za-z0-9_-]{30,}/,
  "Slack token" => /xox[baprs]-[A-Za-z0-9-]{10,}/,
  "authorization header" => /Authorization:\s*(?:Basic|Bearer)\s+\S+/i,
}

blocked_terms = if blocklist
                  abort("blocklist not found: #{blocklist}") unless blocklist.file?
                  blocklist.readlines(chomp: true).each_with_object([]) do |line, terms|
                    value = line.strip
                    terms << value unless value.empty? || value.start_with?("#")
                  end
                else
                  []
                end

violations = []

root.find do |path|
  next unless path.file?

  relative = path.relative_path_from(root)
  bytes = path.binread
  if bytes.include?("\0")
    violations << [relative, 0, "binary file"]
    next
  end

  text = bytes.force_encoding(Encoding::UTF_8)
  unless text.valid_encoding?
    violations << [relative, 0, "invalid UTF-8"]
    next
  end

  text.each_line.with_index(1) do |line, line_number|
    patterns.each do |name, pattern|
      violations << [relative, line_number, name] if line.match?(pattern)
    end
    blocked_terms.each do |term|
      violations << [relative, line_number, "private blocklist term"] if line.include?(term)
    end
  end
end

if violations.empty?
  puts "ho-process public boundary: clean"
  exit 0
end

violations.uniq.each do |path, line, category|
  location = line.zero? ? path.to_s : "#{path}:#{line}"
  warn "#{location}: #{category}"
end
warn "ho-process public boundary: refused"
exit 1
